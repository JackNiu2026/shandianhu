# 闪电虎生产环境配置模板
# 复制此文件为 .env.production 并填入真实值

# 数据库密码（必填，无默认值）
DB_PASSWORD=your_strong_password_here

# JWT 密钥（必填，使用 openssl rand -hex 32 生成）
JWT_SECRET=your_jwt_secret_here

# Initial super-admin password. It must be at least 12 characters in production.
ADMIN_PASSWORD=replace_with_a_unique_12_character_minimum_password

# CORS 允许的前端源（逗号分隔，必须包含小程序请求域名）
CORS_ALLOWED_ORIGINS=https://www.lightning-tiger.com,https://m.lightning-tiger.com

# Set to true only when requests arrive through a trusted reverse proxy.
TRUST_PROXY=false

# AES-256 key used to encrypt database-backed model provider keys (base64, 32 bytes).
# Generate it with: openssl rand -base64 32
MODEL_KEY_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Tencent COS credentials for uploads and generated report files.
COS_BUCKET=your_bucket
COS_REGION=ap-shanghai
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key

# 管理端端口（可选，默认 3000）
ADMIN_PORT=3000

# 微信小程序配置
WECHAT_APPID=your_real_appid
WECHAT_SECRET=your_wechat_secret

# CI/CD 容器仓库（可选）
CONTAINER_REGISTRY=registry.cn-hangzhou.aliyuncs.com
CONTAINER_REGISTRY_USER=your_registry_user
CONTAINER_REGISTRY_TOKEN=your_registry_token

# 不可变发布版本。生产环境必须使用 CI 生成的 sha-<commit> 标签。
IMAGE_TAG=sha-0123456789abcdef0123456789abcdef01234567
