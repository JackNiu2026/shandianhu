{
  "name": "@lightning-tiger/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@lightning-tiger/shared": "workspace:*",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^7.9.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
