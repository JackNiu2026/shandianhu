generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPERADMIN
  EDITOR
  AUDITOR
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileVisibility {
  PRIVATE
}

enum FilePurpose {
  ASSESSMENT_UPLOAD
  ASSESSMENT_ARTIFACT
  REPORT_EXPORT
  AVATAR
  TUTOR_INPUT
  TEACHER_QUALIFICATION
  OTHER
}

enum FileStatus {
  ACTIVE
  DELETED
  REVOKED
}

enum AsyncJobType {
  ASSESSMENT_PROCESSING
  PROFILE_GENERATION
  REPORT_GENERATION
  FILE_PROCESSING
  TUTORING_SUMMARY
}

enum AsyncJobStatus {
  PENDING
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationType {
  ASSESSMENT_COMPLETE
  REPORT_READY
  SYSTEM
  TRIAL_REQUESTED
  TRIAL_ACCEPTED
  TRIAL_REJECTED
  TRIAL_RESCHEDULE_PROPOSED
  TRIAL_CONFIRMED
  TRIAL_CANCELLED
  TRIAL_COMPLETED
  LESSON_SCHEDULED
  LESSON_COMPLETED
  FEEDBACK_RECEIVED
  REVIEW_RECEIVED
  TEACHER_AUDIT_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SHARE
  REVOKE
}

enum AuditActorKind {
  USER
  ADMIN
  SYSTEM
  ASYNC_JOB
}

enum AuditEntityType {
  USER
  CHILD
  ASSESSMENT_RUN
  LEARNING_REPORT
  FILE_OBJECT
  MODEL_CONFIG
  AGENT_CONFIG
  AGENT_PROMPT_VERSION
  TUTOR_CONVERSATION
  TUTOR_QUOTA_ACCOUNT
  TEACHER_APPLICATION
  TEACHER_PROFILE
  TRIAL_BOOKING
  LESSON
  DATA_GRANT
}

enum ModelProvider {
  OPENAI
  AZURE_OPENAI
  ANTHROPIC
  OTHER
}

enum ModelCapability {
  TEXT
  VISION
  EMBEDDING
}

enum ModelUsagePurpose {
  ASSESSMENT
  PROFILE_GENERATION
  REPORT_GENERATION
  AI_TUTORING
  PROMPT_TEST
  OTHER
}

enum ModelUsageStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AssessmentVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AssessmentType {
  DIAGNOSTIC
  PRACTICE
  PROGRESS
}

enum AssessmentRunStatus {
  CREATED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ArtifactKind {
  SOURCE_IMAGE
  OCR_TEXT
  ANALYSIS_JSON
  OUTPUT_FILE
}

enum EvidenceSource {
  ASSESSMENT
  MANUAL
  IMPORTED
  MODEL
  AI_TUTOR_SUMMARY
  TEACHER_FEEDBACK
}

enum ReportStatus {
  DRAFT
  READY
  ARCHIVED
}

// V2.2 智学系统枚举

enum Subject {
  CHINESE
  MATH
  ENGLISH
  PHYSICS
  CHEMISTRY
}

enum SchoolStage {
  PRIMARY
  MIDDLE
  HIGH
}

enum AgentStatus {
  ENABLED
  DISABLED
}

enum PromptStatus {
  DRAFT
  TESTING
  TESTED
  PUBLISHED
  SUPERSEDED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum TutorMessageRole {
  USER
  ASSISTANT
}

enum MessageGenerationStatus {
  PENDING
  COMPLETE
  PARTIAL
  INTERRUPTED
  FAILED
  CANCELLED
}

enum QuotaLedgerKind {
  RESERVE
  SETTLE
  RELEASE
  ADJUSTMENT
}

// ─── V2.3 真人家教闭环 ─────────────────────────────────────

enum TeacherApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_MORE_INFO
  APPROVED
  PAUSED
  BANNED
}

enum QualificationType {
  IDENTITY
  EDUCATION
  TEACHING_CERT
  SUBJECT_CERT
  OTHER
}

enum QualificationReviewStatus {
  PENDING
  PASS
  FAIL
}

enum TeacherServiceStatus {
  ACTIVE
  PAUSED
  BANNED
}

enum TeachingMode {
  ONLINE
  IN_HOME
  IN_CENTER
}

enum ScheduleSourceType {
  TRIAL
  LESSON
  BLOCKED
}

enum AvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE
}

enum TrialBookingStatus {
  REQUESTED
  ACCEPTED
  RESCHEDULE_PROPOSED
  REJECTED
  PARENT_CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum LessonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DataGrantScope {
  BASIC_PROFILE
  LEARNING_NEEDS
}

enum FeedbackPerformance {
  STRONG
  STEADY
  NEEDS_SUPPORT
}

model User {
  id                String             @id @default(cuid())
  wechatOpenId      String             @unique
  wechatUnionId     String?            @unique
  phone             String?            @unique
  status            AccountStatus      @default(ACTIVE)
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  parentProfile     ParentProfile?
  authSessions      AuthSession[]
  fileObjects       FileObject[]       @relation("FileOwner")
  requestedJobs     AsyncJob[]         @relation("JobRequester")
  notifications     Notification[]
  actorAuditLogs    AuditLog[]         @relation("AuditActorUser")
  subjectAuditLogs  AuditLog[]         @relation("AuditSubjectUser")
  modelUsageLedgers ModelUsageLedger[]
  assessmentRuns    AssessmentRun[]    @relation("AssessmentRequester")
  reportShares      ReportShare[]      @relation("ReportShareCreator")
  teacherApplications TeacherApplication[] @relation("TeacherApplicationUser")
  teacherProfile    TeacherProfile?
}

model ParentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  activeChildId String?
  serviceAreaCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeChild   Child?  @relation("ActiveChild", fields: [id, activeChildId], references: [parentProfileId, id], onDelete: Restrict)
  children      Child[] @relation("ParentChildren")
  fileObjects   FileObject[] @relation("FileParentProfile")
  notifications Notification[] @relation("NotificationParentProfile")
  quotaAccount  TutorQuotaAccount?
  trialBookingsParent TrialBooking[] @relation("TrialBookingsByParent")
  dataGrantsGiven DataGrant[] @relation("DataGrantsByParent")
  reviewsGiven  ParentReview[]     @relation("ParentReviewByParent")

  @@unique([id, activeChildId])
  @@unique([userId, id])
}

model Child {
  id              String             @id @default(cuid())
  parentProfileId String
  name            String
  birthDate       DateTime?
  grade           String?
  schoolName      String?
  learningGoals   String[]           @default([])
  deletedAt       DateTime?
  purgeAfter      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  parentProfile   ParentProfile      @relation("ParentChildren", fields: [parentProfileId], references: [id], onDelete: Cascade)
  activeForParent ParentProfile?     @relation("ActiveChild")
  asyncJobs       AsyncJob[]
  modelUsage      ModelUsageLedger[]
  assessmentRuns  AssessmentRun[]
  evidence        LearningEvidence[]
  fileObjects     FileObject[]       @relation("FileChild")
  learningProfile LearningProfile?
  reports         LearningReport[]
  notifications   Notification[]       @relation("NotificationChild")
  auditLogs       AuditLog[]
  tutorConversations TutorConversation[]
  tutoringSummaries TutoringSummary[]
  quotaLedgers   TutorQuotaLedger[]
  trialBookingsChild TrialBooking[] @relation("TrialBookingChild")
  lessonsChild   Lesson[]           @relation("LessonChild")
  dataGrantsChild DataGrant[]       @relation("DataGrantChild")
  reviewsChild   ParentReview[]     @relation("ParentReviewChild")

  @@index([parentProfileId])
  @@index([parentProfileId, deletedAt])
  @@index([deletedAt, purgeAfter])
  @@unique([parentProfileId, id])
}

model AuthSession {
  id         String        @id @default(cuid())
  userId     String
  tokenHash  String        @unique
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model AdminUser {
  id           String                 @id @default(cuid())
  email        String                 @unique
  passwordHash String
  role         AdminRole              @default(EDITOR)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]             @relation("AuditActorAdmin")
  definitions  AssessmentDefinition[]
  modelConfigs ModelConfig[]
  publishedAssessmentVersions AssessmentVersion[] @relation("AssessmentVersionPublisher")
  agentConfigs            AgentConfig[]           @relation("AgentConfigUpdatedBy")
  createdPromptVersions   AgentPromptVersion[]   @relation("PromptVersionCreatedBy")
  promptTests             AgentPromptTest[]
}

model AdminSession {
  id          String        @id @default(cuid())
  adminUserId String
  tokenHash   String        @unique
  status      SessionStatus @default(ACTIVE)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  adminUser   AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, status])
  @@index([expiresAt])
}

model FileObject {
  id             String         @id @default(cuid())
  ownerUserId    String
  parentProfileId String?
  childId        String?
  objectKey      String         @unique
  contentType    String
  byteSize       Int
  visibility     FileVisibility @default(PRIVATE)
  purpose        FilePurpose
  status         FileStatus     @default(ACTIVE)
  checksumSha256 String?
  deletedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  owner          User           @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  parentProfile  ParentProfile? @relation("FileParentProfile", fields: [ownerUserId, parentProfileId], references: [userId, id], onDelete: Restrict)
  child          Child?         @relation("FileChild", fields: [parentProfileId, childId], references: [parentProfileId, id], onDelete: Restrict)
  artifacts      AssessmentArtifact[]
  reports        LearningReport[]
  messageAttachments MessageAttachment[]
  qualifications TeacherQualification[] @relation("QualificationFile")

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status, deletedAt])
  @@index([childId, purpose, status])
  @@unique([childId, id])
}

model AsyncJob {
  id                String         @id @default(cuid())
  requestedByUserId String?
  childId           String?
  assessmentRunId   String?
  type              AsyncJobType
  dedupeKey         String         @unique
  status            AsyncJobStatus @default(PENDING)
  attempt           Int            @default(0)
  maxAttempts       Int            @default(3)
  retryAt           DateTime?
  payload           Json?
  result            Json?
  errorCode         String?
  errorDetail       String?
  availableAt       DateTime       @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requestedBy       User?          @relation("JobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  child             Child?         @relation(fields: [childId], references: [id], onDelete: SetNull)
  assessmentRun     AssessmentRun? @relation(fields: [childId, assessmentRunId], references: [childId, id], onDelete: SetNull)
  auditLogs         AuditLog[]
  tutoringSummaries TutoringSummary[]

  @@index([status, retryAt, availableAt])
  @@index([childId, createdAt])
}

model Notification {
  id              String             @id @default(cuid())
  userId          String
  parentProfileId String?
  childId         String?
  dedupeKey       String             @unique
  type            NotificationType
  status          NotificationStatus @default(UNREAD)
  targetRoute     String?
  targetParams    Json?
  body            Json
  readAt          DateTime?
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentProfile   ParentProfile?     @relation("NotificationParentProfile", fields: [userId, parentProfileId], references: [userId, id], onDelete: Restrict)
  child           Child?             @relation("NotificationChild", fields: [parentProfileId, childId], references: [parentProfileId, id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([childId, status, createdAt])
}

model AuditLog {
  id               String          @id @default(cuid())
  actorKind        AuditActorKind
  actorId          String?
  actorUserId      String?
  actorAdminUserId String?
  subjectUserId    String?
  childId          String?
  asyncJobId       String?
  assessmentRunId  String?
  learningReportId String?
  entityType       AuditEntityType
  entityId         String
  action           AuditAction
  sanitizedDiff    Json?
  createdAt        DateTime        @default(now())
  actorUser        User?           @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdminUser   AdminUser?      @relation("AuditActorAdmin", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  subjectUser      User?           @relation("AuditSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  child            Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)
  asyncJob         AsyncJob?       @relation(fields: [asyncJobId], references: [id], onDelete: SetNull)
  assessmentRun    AssessmentRun?  @relation(fields: [assessmentRunId], references: [id], onDelete: SetNull)
  learningReport   LearningReport? @relation(fields: [learningReportId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([actorKind, actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([childId, createdAt])
}

model ModelConfig {
  id               String                  @id @default(cuid())
  createdByAdminId String?
  provider         ModelProvider
  endpointUrl      String
  apiKeyCiphertext String
  apiKeyIv         String
  apiKeyTag        String
  modelName        String
  capabilities     ModelCapability
  visionEnabled    Boolean                 @default(false)
  timeoutMs        Int                     @default(30000)
  maxOutputTokens  Int                     @default(1024)
  temperature      Decimal                 @default(0.0) @db.Decimal(3, 2)
  inputCostMicros  BigInt                  @default(0)
  outputCostMicros BigInt                  @default(0)
  imageCostMicros  BigInt                  @default(0)
  enabled          Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdByAdmin   AdminUser?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  usageLedgers     ModelUsageLedger[]
  profileVersions  LearningProfileVersion[]
  primaryForAgents AgentConfig[]           @relation("AgentPrimaryModel")
  fallbackForAgents AgentConfig[]          @relation("AgentFallbackModel")

  @@unique([provider, modelName, capabilities])
}

model ModelUsageLedger {
  id             String            @id @default(cuid())
  callId         String            @unique
  modelConfigId  String
  userId         String?
  childId        String?
  purpose        ModelUsagePurpose
  status         ModelUsageStatus
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  imageCount     Int               @default(0)
  latencyMs      Int               @default(0)
  microCost      BigInt            @default(0)
  sanitizedError String?
  createdAt      DateTime          @default(now())
  modelConfig    ModelConfig       @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  child          Child?            @relation(fields: [childId], references: [id], onDelete: SetNull)
  assessmentResult AssessmentResult? @relation("AssessmentResultModelCall")
  promptTests    AgentPromptTest[]
  tutoringSummaries TutoringSummary[]

  @@index([modelConfigId, purpose, createdAt])
  @@index([modelConfigId, status, createdAt])
  @@index([childId, createdAt])
}

model AssessmentDefinition {
  id               String              @id @default(cuid())
  createdByAdminId String?
  slug             String              @unique
  name             String
  description      String?
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdByAdmin   AdminUser?          @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  versions         AssessmentVersion[]
}

model AssessmentVersion {
  id                     String                  @id @default(cuid())
  assessmentDefinitionId String
  version                Int
  checksum               String
  type                   AssessmentType
  status                 AssessmentVersionStatus @default(DRAFT)
  specification          Json
  configuration          Json
  publishedAt            DateTime?
  publishedByAdminId     String?
  createdAt              DateTime                @default(now())
  definition             AssessmentDefinition    @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Cascade)
  publishedByAdmin       AdminUser?              @relation("AssessmentVersionPublisher", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  runs                   AssessmentRun[]

  @@unique([assessmentDefinitionId, version])
  @@unique([assessmentDefinitionId, checksum])
}

model AssessmentRun {
  id                  String              @id @default(cuid())
  assessmentVersionId String
  childId             String
  idempotencyKey      String
  requestedByUserId   String?
  subject             String?
  status              AssessmentRunStatus @default(CREATED)
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  assessmentVersion   AssessmentVersion   @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)
  child               Child               @relation(fields: [childId], references: [id], onDelete: Restrict)
  requestedBy         User?               @relation("AssessmentRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  artifacts           AssessmentArtifact[]
  result              AssessmentResult?
  evidence            LearningEvidence[]
  asyncJobs           AsyncJob[]
  auditLogs           AuditLog[]

  @@index([childId, createdAt])
  @@index([status, createdAt])
  @@unique([childId, id])
  @@unique([childId, idempotencyKey])
}

model AssessmentArtifact {
  id              String        @id @default(cuid())
  childId         String
  assessmentRunId String
  fileObjectId    String
  ordinal         Int
  kind            ArtifactKind
  metadata        Json?
  createdAt       DateTime      @default(now())
  assessmentRun   AssessmentRun @relation(fields: [childId, assessmentRunId], references: [childId, id], onDelete: Cascade)
  fileObject      FileObject    @relation(fields: [childId, fileObjectId], references: [childId, id], onDelete: Restrict)

  @@index([assessmentRunId, kind])
  @@unique([assessmentRunId, ordinal])
}

model AssessmentResult {
  id                 String            @id @default(cuid())
  assessmentRunId    String            @unique
  modelUsageLedgerId String?           @unique
  score              Decimal?          @db.Decimal(7, 2)
  level              String?
  parentNarrative    String?
  result             Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assessmentRun      AssessmentRun     @relation(fields: [assessmentRunId], references: [id], onDelete: Cascade)
  modelUsageLedger   ModelUsageLedger? @relation("AssessmentResultModelCall", fields: [modelUsageLedgerId], references: [id], onDelete: Restrict)
}

model LearningEvidence {
  id              String         @id @default(cuid())
  childId         String
  assessmentRunId String?
  source          EvidenceSource
  sourceId        String
  observedAt      DateTime       @default(now())
  payload         Json
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  child           Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  assessmentRun   AssessmentRun? @relation(fields: [childId, assessmentRunId], references: [childId, id], onDelete: Restrict)
  profileVersionDependencies LearningProfileVersionEvidence[]
  tutoringSummaries TutoringSummary[]

  @@index([childId, observedAt])
  @@index([childId, revokedAt, observedAt])
  @@index([source, sourceId, revokedAt])
  @@unique([childId, source, sourceId])
  @@unique([childId, id])
}

model LearningProfile {
  id               String                   @id @default(cuid())
  childId          String                   @unique
  currentVersionId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  child            Child                    @relation(fields: [childId], references: [id], onDelete: Cascade)
  currentVersion   LearningProfileVersion?  @relation("CurrentLearningProfileVersion", fields: [id, currentVersionId], references: [learningProfileId, id], onDelete: Restrict)
  versions         LearningProfileVersion[] @relation("ProfileVersions")
  reports          LearningReport[]
  evidenceDependencies LearningProfileVersionEvidence[]

  @@unique([id, currentVersionId])
  @@unique([childId, id])
}

model LearningProfileVersion {
  id                   String           @id @default(cuid())
  learningProfileId    String
  modelConfigId        String?
  version              Int
  ruleVersion          String
  snapshot             Json
  confidenceBasis      Json
  revokedAt            DateTime?
  createdAt            DateTime         @default(now())
  learningProfile      LearningProfile  @relation("ProfileVersions", fields: [learningProfileId], references: [id], onDelete: Cascade)
  modelConfig          ModelConfig?     @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  currentFor           LearningProfile? @relation("CurrentLearningProfileVersion")
  reports              LearningReport[]
  evidenceDependencies LearningProfileVersionEvidence[]

  @@unique([learningProfileId, version])
  @@unique([learningProfileId, id])
  @@index([modelConfigId, revokedAt])
}

model LearningProfileVersionEvidence {
  id                       String                 @id @default(cuid())
  childId                  String
  learningProfileId        String
  learningProfileVersionId String
  learningEvidenceId       String
  createdAt                DateTime               @default(now())
  learningProfile          LearningProfile        @relation(fields: [childId, learningProfileId], references: [childId, id], onDelete: Restrict)
  learningProfileVersion   LearningProfileVersion @relation(fields: [learningProfileId, learningProfileVersionId], references: [learningProfileId, id], onDelete: Restrict)
  learningEvidence         LearningEvidence       @relation(fields: [childId, learningEvidenceId], references: [childId, id], onDelete: Restrict)

  @@unique([learningProfileVersionId, learningEvidenceId])
  @@index([learningEvidenceId])
}

model LearningReport {
  id                       String                 @id @default(cuid())
  childId                  String
  learningProfileId        String
  learningProfileVersionId String
  sequence                 Int
  fileObjectId             String?
  status                   ReportStatus           @default(DRAFT)
  narrativeVersion         String                 @default("v1")
  body                     Json
  publishedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  child                    Child                  @relation(fields: [childId], references: [id], onDelete: Restrict)
  learningProfile          LearningProfile        @relation(fields: [childId, learningProfileId], references: [childId, id], onDelete: Restrict)
  learningProfileVersion   LearningProfileVersion @relation(fields: [learningProfileId, learningProfileVersionId], references: [learningProfileId, id], onDelete: Restrict)
  fileObject               FileObject?            @relation(fields: [childId, fileObjectId], references: [childId, id], onDelete: Restrict)
  shares                   ReportShare[]
  auditLogs                AuditLog[]

  @@index([learningProfileId, createdAt])
  @@unique([childId, sequence])
}

model ReportShare {
  id               String         @id @default(cuid())
  learningReportId String
  createdByUserId  String?
  tokenHash        String         @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  learningReport   LearningReport @relation(fields: [learningReportId], references: [id], onDelete: Cascade)
  createdBy        User?          @relation("ReportShareCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([learningReportId])
  @@index([expiresAt])
}

// V2.2 智学系统模型

model AgentConfig {
  id                        String              @id @default(cuid())
  subject                   Subject
  schoolStage               SchoolStage
  status                    AgentStatus         @default(DISABLED)
  publishedPromptVersionId  String?
  primaryModelConfigId      String?
  fallbackModelConfigId     String?
  temperature               Float               @default(0.4)
  maxOutputTokens           Int                 @default(2048)
  updatedByAdminId          String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  prompts                   AgentPromptVersion[]
  conversations             TutorConversation[]
  publishedPromptVersion    AgentPromptVersion? @relation("AgentPublishedPrompt", fields: [id, publishedPromptVersionId], references: [agentId, id], onDelete: Restrict)
  primaryModelConfig        ModelConfig?        @relation("AgentPrimaryModel", fields: [primaryModelConfigId], references: [id], onDelete: Restrict)
  fallbackModelConfig       ModelConfig?        @relation("AgentFallbackModel", fields: [fallbackModelConfigId], references: [id], onDelete: Restrict)
  updatedByAdmin            AdminUser?          @relation("AgentConfigUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([subject, schoolStage])
  @@unique([id, publishedPromptVersionId])
}

model AgentPromptVersion {
  id            String        @id @default(cuid())
  agentId       String
  sequence      Int
  content       String
  checksum      String
  status        PromptStatus  @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  supersedesId  String?
  createdAt     DateTime      @default(now())
  agent         AgentConfig   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy     AdminUser     @relation("PromptVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes    AgentPromptVersion? @relation("PromptSupersedes", fields: [agentId, supersedesId], references: [agentId, id], onDelete: SetNull)
  supersededBy  AgentPromptVersion[] @relation("PromptSupersedes")
  tests         AgentPromptTest[]
  publishedFor  AgentConfig?  @relation("AgentPublishedPrompt")
  conversations TutorConversation[]

  @@unique([agentId, sequence])
  @@unique([agentId, id])
}

model AgentPromptTest {
  id                 String           @id @default(cuid())
  promptVersionId    String
  modelUsageLedgerId String           @unique
  createdById        String?
  status             PromptStatus     @default(TESTING)
  inputPreview       String?
  outputPreview      String?
  passed             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  promptVersion      AgentPromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  modelUsageLedger   ModelUsageLedger @relation(fields: [modelUsageLedgerId], references: [id], onDelete: Restrict)
  createdByAdmin     AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([promptVersionId, createdAt])
}

model TutorConversation {
  id               String              @id @default(cuid())
  childId          String
  agentId          String
  promptVersionId  String
  status           ConversationStatus  @default(ACTIVE)
  title            String?
  lastActivityAt   DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  child            Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  agent            AgentConfig         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  promptVersion    AgentPromptVersion  @relation(fields: [agentId, promptVersionId], references: [agentId, id], onDelete: Restrict)
  messages         TutorMessage[]
  summaries        TutoringSummary[]

  @@index([childId, lastActivityAt])
  @@index([agentId, status])
}

model TutorMessage {
  id               String                 @id @default(cuid())
  conversationId   String
  clientMessageId  String
  role             TutorMessageRole
  content          String                 @default("")
  generationStatus MessageGenerationStatus @default(COMPLETE)
  modelCallId      String?
  sequence         Int
  createdAt        DateTime               @default(now())
  conversation     TutorConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments      MessageAttachment[]

  @@unique([conversationId, clientMessageId])
  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id           String        @id @default(cuid())
  messageId    String
  fileObjectId String
  ordinal      Int
  createdAt    DateTime      @default(now())
  message      TutorMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileObject   FileObject    @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@unique([messageId, ordinal])
  @@index([fileObjectId])
}

model TutoringSummary {
  id               String           @id @default(cuid())
  conversationId   String
  childId          String
  version          Int
  summary          Json
  modelCallId      String?
  evidenceId       String?          @unique
  asyncJobId       String?
  createdAt        DateTime         @default(now())
  conversation     TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  child            Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  modelCall        ModelUsageLedger? @relation(fields: [modelCallId], references: [id], onDelete: SetNull)
  evidence         LearningEvidence? @relation(fields: [childId, evidenceId], references: [childId, id], onDelete: SetNull)
  asyncJob         AsyncJob?        @relation(fields: [asyncJobId], references: [id], onDelete: SetNull)

  @@unique([conversationId, version])
  @@index([childId, createdAt])
}

model TutorQuotaAccount {
  id              String   @id @default(cuid())
  parentProfileId String   @unique
  availablePoints BigInt   @default(0)
  reservedPoints  BigInt   @default(0)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  ledgers         TutorQuotaLedger[]

  @@index([parentProfileId])
}

model TutorQuotaLedger {
  id             String          @id @default(cuid())
  accountId      String
  operationKey   String          @unique
  childId        String?
  modelCallId    String?
  kind           QuotaLedgerKind
  points         BigInt
  balanceAfter   BigInt
  reservationId  String?
  reason         String?
  createdAt      DateTime        @default(now())
  account        TutorQuotaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  child          Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([childId, createdAt])
  @@index([reservationId])
}

// ─── V2.3 真人家教：申请、资质、审核、公开资料 ───────────────

model TeacherApplication {
  id              String                  @id @default(cuid())
  userId          String
  status          TeacherApplicationStatus @default(DRAFT)
  legalName       String
  education       String?
  experienceYears Int?
  pricePerHour    Int?
  bio             String?
  teachingModes   TeachingMode[]
  serviceAreaCode String?
  version         Int                     @default(0)
  submittedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation("TeacherApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  qualifications  TeacherQualification[]
  auditRecords    TeacherAuditRecord[]
  profile         TeacherProfile?

  @@index([userId, status])
  @@index([status, updatedAt])
}

model TeacherQualification {
  id             String                   @id @default(cuid())
  applicationId  String
  type           QualificationType
  fileObjectId   String
  reviewStatus   QualificationReviewStatus @default(PENDING)
  reviewReason   String?
  reviewedAt     DateTime?
  reviewedByAdminUserId String?
  createdAt      DateTime                 @default(now())
  application    TeacherApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileObject     FileObject               @relation("QualificationFile", fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@unique([applicationId, type, fileObjectId])
  @@index([applicationId, reviewStatus])
}

model TeacherAuditRecord {
  id             String   @id @default(cuid())
  applicationId  String
  action         String
  reason         String?
  actorAdminUserId String?
  createdAt      DateTime @default(now())
  application    TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model TeacherProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  applicationId   String              @unique
  displayName     String
  bio             String
  subjects        Subject[]
  schoolStages    SchoolStage[]
  teachingModes   TeachingMode[]
  serviceAreaCodes String[]
  teachingTags    String[]
  experienceYears Int
  pricePerHour    Int
  serviceStatus   TeacherServiceStatus @default(ACTIVE)
  version         Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     TeacherApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  availabilityRules    TeacherAvailabilityRule[]
  availabilityExceptions TeacherAvailabilityException[]
  scheduleReservations  ScheduleReservation[]
  trialBookingsTeacher  TrialBooking[]     @relation("TrialBookingsByTeacher")
  lessonsTeacher        Lesson[]           @relation("LessonsByTeacher")
  dataGrantsReceived    DataGrant[]        @relation("DataGrantsByTeacher")
  reviews               ParentReview[]

  @@index([serviceStatus])
}

// ─── 排期 ──────────────────────────────────────────────────

model TeacherAvailabilityRule {
  id              String   @id @default(cuid())
  teacherProfileId String
  weekday         Int      // 1=周一 … 7=周日
  startMinute     Int      // 当日分钟偏移（北京时间）
  endMinute       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  teacherProfile  TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, weekday, startMinute, endMinute])
  @@index([teacherProfileId, weekday])
}

model TeacherAvailabilityException {
  id              String                   @id @default(cuid())
  teacherProfileId String
  date            DateTime                 // 仅取 date 部分（北京时间）
  type            AvailabilityExceptionType
  startMinute     Int?
  endMinute       Int?
  reason          String?
  createdAt       DateTime                 @default(now())
  teacherProfile  TeacherProfile           @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, date])
  @@index([teacherProfileId, date])
}

model ScheduleReservation {
  id               String            @id @default(cuid())
  teacherProfileId String
  sourceType       ScheduleSourceType
  sourceId         String
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  teacherProfile   TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([teacherProfileId, startsAt, endsAt])
}

// ─── 试听 ──────────────────────────────────────────────────

model TrialBooking {
  id               String            @id @default(cuid())
  idempotencyKey   String
  parentProfileId  String
  childId          String
  teacherProfileId String
  subject          Subject
  startsAt         DateTime
  endsAt           DateTime
  status           TrialBookingStatus @default(REQUESTED)
  mode             TeachingMode?
  parentNote       String?
  version          Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parentProfile    ParentProfile     @relation("TrialBookingsByParent", fields: [parentProfileId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile    @relation("TrialBookingsByTeacher", fields: [teacherProfileId], references: [id], onDelete: Restrict)
  child            Child             @relation("TrialBookingChild", fields: [childId], references: [id], onDelete: Cascade)
  changes          BookingChange[]
  lesson           Lesson?

  @@unique([parentProfileId, idempotencyKey])
  @@index([teacherProfileId, startsAt, endsAt])
  @@index([parentProfileId, status])
  @@index([childId, startsAt])
}

model BookingChange {
  id              String   @id @default(cuid())
  bookingId       String
  fromStatus      TrialBookingStatus
  toStatus        TrialBookingStatus
  action          String   // ACCEPT / REJECT / PROPOSE_RESCHEDULE / PARENT_CONFIRM / CANCEL / COMPLETE / MARK_READY
  actorKind       String   // PARENT / TEACHER / ADMIN
  actorId         String
  reason          String?
  proposedStartsAt DateTime?
  proposedEndsAt   DateTime?
  createdAt       DateTime @default(now())
  booking         TrialBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ─── 课程、反馈、评价 ──────────────────────────────────────

model Lesson {
  id               String            @id @default(cuid())
  trialBookingId   String?           @unique
  childId          String
  teacherProfileId String
  subject          Subject
  startsAt         DateTime
  endsAt           DateTime
  status           LessonStatus      @default(SCHEDULED)
  mode             TeachingMode?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trialBooking     TrialBooking?     @relation(fields: [trialBookingId], references: [id], onDelete: SetNull)
  child            Child             @relation("LessonChild", fields: [childId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile    @relation("LessonsByTeacher", fields: [teacherProfileId], references: [id], onDelete: Restrict)
  feedbackVersions TeacherFeedback[]
  review           ParentReview?

  @@index([teacherProfileId, startsAt, endsAt])
  @@index([childId, startsAt])
  @@index([status])
}

model TeacherFeedback {
  id              String             @id @default(cuid())
  lessonId        String
  sequence        Int
  lessonContent   Json
  performance     FeedbackPerformance
  difficulties    Json
  suggestions     Json
  privateTeacherNote String?
  isCurrent       Boolean            @default(true)
  supersedesId    String?
  createdByTeacherProfileId String
  correctionReason String?
  createdAt       DateTime           @default(now())
  lesson          Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  supersedes      TeacherFeedback?   @relation("FeedbackSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    TeacherFeedback[]  @relation("FeedbackSupersedes")

  @@unique([lessonId, sequence])
  @@index([lessonId, isCurrent])
  @@index([createdByTeacherProfileId])
}

model ParentReview {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  parentProfileId String
  childId         String
  teacherProfileId String
  rating          Int      // 1–5
  content         String
  authorDisplayName String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lesson          Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parentProfile   ParentProfile   @relation("ParentReviewByParent", fields: [parentProfileId], references: [id], onDelete: Cascade)
  child           Child           @relation("ParentReviewChild", fields: [childId], references: [id], onDelete: Cascade)
  teacherProfile  TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, createdAt])
  @@index([parentProfileId, createdAt])
}

// ─── 授权 ──────────────────────────────────────────────────

model DataGrant {
  id               String           @id @default(cuid())
  parentProfileId  String
  childId          String
  teacherProfileId String
  scopes           DataGrantScope[]
  validFrom        DateTime
  validUntil       DateTime?
  revokedAt        DateTime?
  sourceBookingId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  parentProfile    ParentProfile    @relation("DataGrantsByParent", fields: [parentProfileId], references: [id], onDelete: Cascade)
  child            Child            @relation("DataGrantChild", fields: [childId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile   @relation("DataGrantsByTeacher", fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, childId, revokedAt])
  @@index([parentProfileId, childId])
}
