# ============ 数据库（必填） ============
# PostgreSQL 连接字符串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lightning_tiger?schema=public"

# ============ Redis 队列（必填，BullMQ 异步任务） ============
REDIS_URL="redis://localhost:6379"

# ============ 管理后台会话密钥（必填） ============
# 注意：V2 使用不透明令牌 + DB Session，不使用 JWT。
# 此变量仅为向后兼容保留，生产可不设置；如设置须为随机长字符串。
JWT_SECRET="change-me-to-a-random-secret"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# CORS 允许的前端源（逗号分隔，移动端和管理端域名）
CORS_ALLOWED_ORIGINS="http://localhost:10086"

# ============ 腾讯云 COS（文件存储，必填） ============
COS_BUCKET=""
COS_REGION=""
COS_SECRET_ID=""
COS_SECRET_KEY=""

# ============ 模型网关密钥（AI 调用，必填） ============
# AES-256 主密钥，base64 编码，长度 32 字节。生成方式：
#   openssl rand -base64 32
MODEL_KEY_ENCRYPTION_KEY=""

# ============ 登录限流（可选） ============
# 是否信任 x-forwarded-for（反向代理后开启）
# TRUST_PROXY="true"

# ============ AI 学情诊断（可选：配置后启用真实 AI 错题分析，不配置则使用 Demo 模式） ============
# AI_API_KEY="sk-your-api-key"
# AI_API_URL="https://api.openai.com/v1/chat/completions"
# AI_MODEL="gpt-4o"
