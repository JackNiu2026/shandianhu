# 数据库连接字符串（开发环境使用 PostgreSQL）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lightning_tiger?schema=public"

# JWT 密钥（生产环境务必更换为随机长字符串）
JWT_SECRET="change-me-to-a-random-secret"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# CORS 允许的前端源（逗号分隔，移动端和管理端域名）
CORS_ALLOWED_ORIGINS="http://localhost:10086"

# AI 学情诊断（可选：配置后启用真实 AI 错题分析，不配置则使用 Demo 模式）
# AI_API_KEY="sk-your-api-key"
# AI_API_URL="https://api.openai.com/v1/chat/completions"
# AI_MODEL="gpt-4o"
