{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "闪电虎 C 端 - Taro 4 微信小程序",
  "scripts": {
    "dev:weapp": "node scripts/inject-appid.js && taro build --type weapp --watch",
    "build:weapp": "node scripts/inject-appid.js && taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lightning-tiger/shared": "workspace:*",
    "@tarojs/components": "4.x",
    "@tarojs/helper": "4.x",
    "@tarojs/plugin-framework-react": "4.x",
    "@tarojs/plugin-platform-weapp": "4.x",
    "@tarojs/react": "^4.2.1",
    "@tarojs/runtime": "4.x",
    "@tarojs/shared": "4.x",
    "@tarojs/taro": "4.x",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@tarojs/cli": "4.x",
    "@tarojs/webpack5-runner": "4.x",
    "@types/react": "^18.0.0",
    "@types/webpack": "5.x",
    "babel-preset-taro": "4.x",
    "react-refresh": "^0.14.0",
    "sass": "^1.69.0",
    "typescript": "^5.7.0",
    "jsdom": "^24.1.3",
    "vitest": "^3.0.0",
    "webpack": "^5.78.0"
  }
}
